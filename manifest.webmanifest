{
  "name": "Thaifund",
  "short_name": "Thaifund",
  "description": "A photo editor that works entirely in your browser. Photos stay on your computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141312",
  "theme_color": "#141312",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/*": [".jpg", ".jpeg", ".png", ".webp", ".avif", ".gif", ".bmp", ".tif", ".tiff"] } }
  ]
}
